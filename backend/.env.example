# LLM BYOK（OpenAI 兼容 Chat Completions）
# 支持 OpenAI / MiniMax / StepFun / DeepSeek / OpenRouter 等
LLM_API_BASE=https://api.minimaxi.com/v1
LLM_API_KEY=sk-your-key-here
LLM_MODEL=MiniMax-M3
LLM_MAX_TOKENS=4096
LLM_CONTEXT_WINDOW=128000

# 嵌入模型独立配置（RAG 用）；未填则回退上方 LLM_*
# LLM_EMBEDDINGS_BASE=
# LLM_EMBEDDINGS_KEY=
# LLM_EMBEDDINGS_MODEL=

# RAG 后端：local | stepfun | none
RAG_BACKEND=local
# STEPFUN_VECTOR_STORE_ID=

# 服务
DATABASE_URL=sqlite:///./data/interviewos.db
UPLOAD_DIR=./uploads
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
HOST=127.0.0.1
PORT=8000
# ENV=dev
# ALLOW_LOCAL_LLM=false

# 语音管道默认回退（正式指派请在「设置」页配置三处理器，勿把思考 Key 当 ASR Key）
# WHISPER_MODEL：仅当识别处理者=local 或云端失败回退时使用（tiny/base/small/...）
WHISPER_MODEL=base
# TTS_VOICE：Edge 音色；若播报选 MiniMax Speech 则为 voice_id（如 male-qn-qingse）
TTS_VOICE=zh-CN-XiaoxiaoNeural
# SILENCE_NUDGE_SECONDS=10

# 生产环境强烈建议设置 master key（任意 ≥16 字节字符串，或 base64）
# INTERVIEWOS_SECRET_KEY=
