# LLM BYOK（OpenAI 兼容 Chat Completions）
# 支持任意 OpenAI 兼容供应商（在设置页选择或填写 api_base / model）
LLM_API_BASE=https://api.openai.com/v1
LLM_API_KEY=sk-your-key-here
LLM_MODEL=gpt-4o
LLM_MAX_TOKENS=4096
LLM_CONTEXT_WINDOW=128000

# 嵌入模型独立配置（RAG 用）；未填则回退上方 LLM_*
# LLM_EMBEDDINGS_BASE=
# LLM_EMBEDDINGS_KEY=
# LLM_EMBEDDINGS_MODEL=

# RAG 后端：local | stepfun | none
RAG_BACKEND=local
# STEPFUN_VECTOR_STORE_ID=

# 服务
DATABASE_URL=sqlite:///./data/interviewos.db
UPLOAD_DIR=./uploads
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
HOST=127.0.0.1
PORT=8000
# ENV=dev
# ALLOW_LOCAL_LLM=false
# COOKIE_SECURE=   # true/false；留空则自动（https 或可信代理 X-Forwarded-Proto）
# TRUSTED_PROXY_CIDRS=127.0.0.0/8,::1/128

# 语音管道默认回退（正式指派请在「设置」页配置三处理器；思考 Key 不得用作 ASR Key）
# WHISPER_MODEL：仅当识别处理者=local 或云端失败回退时使用（tiny/base/small/...）
WHISPER_MODEL=base
# TTS_VOICE：Edge 音色 id，或其它 TTS 供应商的 voice_id
TTS_VOICE=zh-CN-XiaoxiaoNeural
# SILENCE_NUDGE_SECONDS=10

# 生产环境强烈建议设置 master key（任意 ≥16 字节字符串，或 base64）
# 未设置时默认写入 backend/data/.secret.key（与 DB 同目录）
# INTERVIEWOS_SECRET_KEY=
